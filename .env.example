# Copy to .env for local development
NODE_ENV=development
PORT=3000
# docker compose up -d starts this database
DATABASE_URL=postgres://amplify:amplify@localhost:5432/amplify
# Set to true for hosted databases such as Supabase or Neon
DATABASE_SSL=false
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ORIGIN=*
# Hosting helpers (optional): apply migrations and create demo data when the server starts
RUN_MIGRATIONS=false
SEED_DEMO_ON_BOOT=false
# Payment provider is simulated. true lets a request choose the outcome, so every state can be demonstrated
ALLOW_SIMULATED_OUTCOMES=true
# Used by npm run db:seed (and SEED_DEMO_ON_BOOT). The password needs at least 10 characters
SEED_ADMIN_EMAIL=reviewer@amplify.local
SEED_ADMIN_PASSWORD=change-this-password
